# ========================================================
# Git Ignore - Magic Box
# ========================================================

# 1. Dependencias de Node.js
node_modules/

# 2. Sesión de WhatsApp (¡CRÍTICO: Seguridad y credenciales!)
# Nunca debe subirse a un repositorio público ni privado
auth_info_baileys/
*.session

# 3. Audios personales y grabaciones familiares (Privacidad)
data/received/*
!data/received/.gitkeep
data/recordings/*
!data/recordings/.gitkeep
data/temp*

# Archivos de audio temporales en la raíz o carpetas de datos
*.raw
*.bin
*.tmp

# 4. Logs del sistema
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Archivos del Sistema Operativo y Editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 6. Variables de entorno (si se usan a futuro)
.env
.env.local
